# Node 服务监听端口。宝塔 / Nginx 会反向代理到此端口，不要在防火墙中公开 3000。
PORT=3000

# json：本机预览；mysql：服务器本地 MySQL 建库并导入数据后切换。
DATA_BACKEND=mysql

# 宝塔本地 MySQL。请只在服务器的 .env 中填写真实密码，不要上传或提交 .env。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eureka_boom_prod
DB_USER=eureka_boom_app
DB_PASSWORD=replace-with-a-long-random-password
DB_CONNECTION_LIMIT=5

# 后续登录系统使用。请生成至少 32 字符随机值。
SESSION_SECRET=replace-with-a-long-random-secret

# 教师控制台与审核接口的访问口令。请生成至少 32 字符随机值；它只保存在服务器 .env。
ADMIN_TOKEN=replace-with-a-long-random-admin-token
